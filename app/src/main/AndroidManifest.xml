<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 작업 표시줄에 와이파이·데이터 연결 여부를 보여 주는 데만 씁니다. 인터넷 권한은 없습니다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 앱 메뉴의 "제거"가 안드로이드 제거 확인 창을 띄우는 데 필요합니다. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 빠른 설정의 밝기 막대가 화면 밝기를 바꾸는 데 씁니다. 사용자가 "시스템 설정 변경"을 허용해야만 동작합니다. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- 시작 메뉴에 보여 줄 앱(런처에 나오는 앱) 목록 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 바탕화면에 올릴 수 있는 위젯을 가진 앱 -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- 검색창의 "DNR AI에게 묻기": Chat DNR Ai(기기 안 AI) 질문 창 -->
        <package android:name="com.daesinnam.localai" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <!-- 홈 앱(런처)으로 고를 수 있게.
                 앱 서랍 아이콘(LAUNCHER)은 아래 DexActivity가 맡습니다: 예전 DeX(노트20 · 탭 S9 등)는 홈 앱으로 등록된 화면을
                 "휴대전화 홈 화면에서만 실행 가능"이라며 열지 않기 때문입니다. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 앱 서랍에서 여는 덜누름 데스크. 홈 앱이 아닌 일반 화면이라 DeX 안에서도 창으로 열립니다(화면 · 기능은 같음). -->
        <activity
            android:name=".DexActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.daesinnam.desk.dex"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- DeX에서 화면 밀도가 바뀌어도 앱을 다시 시작하지 않게 (삼성) -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <!-- 창정리 고급 기능(Shizuku) 연결 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
