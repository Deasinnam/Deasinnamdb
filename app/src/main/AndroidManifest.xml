<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 인터넷은 처음 한 번 AI 모델을 내려받을 때만 씁니다. 대화 · 사진은 기기 밖으로 나가지 않습니다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- DNR 음성 엔진: 말로 묻기(녹음은 기기 안에서 받아 적고 지움) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <!-- 문서를 덜누름 워크(DNR Work)로 넘기기 -->
        <package android:name="com.daesinnam.work" />
        <!-- DNR 음성 엔진: 휴대폰의 읽기 음성(TTS) · 기기 안 음성 인식 -->
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 다른 앱에서 사진 · 글을 공유하면 바로 물어보기 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- DNR AI 통로: 다른 덜누름 앱(워크 · 데스크탑앱 …)이 부르는 떠 있는 질문 창.
             사람이 보고 누를 때만 결과가 돌아감 · 기기 안에서만 -->
        <!-- 자비스: DNR AI 음성 모드 — 홈 화면에 따로 아이콘. 기본 디지털 어시스턴트(측면 버튼)로도 부를 수 있음 -->
        <activity
            android:name=".JarvisActivity"
            android:exported="true"
            android:label="자비스"
            android:icon="@mipmap/ic_jarvis"
            android:roundIcon="@mipmap/ic_jarvis"
            android:theme="@style/Theme.LocalAI"
            android:taskAffinity="com.daesinnam.localai.jarvis"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:theme="@style/Theme.LocalAI.Ask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.daesinnam.ai.action.ASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 덜누름 벤치가 자비스(기기 안 AI)를 재는 입구. 같은 서명의 덜누름 앱만 부를 수 있고, 숫자 결과만 돌려줌 -->
        <activity
            android:name=".BenchActivity"
            android:exported="true"
            android:theme="@style/Theme.LocalAI.Ask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="com.daesinnam.ai.action.BENCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 모델 내려받기(약 2.6~3.7GB): 화면을 꺼도 이어지고, 끊겨도 이어받기 -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>
    </application>
</manifest>
