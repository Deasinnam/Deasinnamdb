<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 작업 표시줄에 와이파이·데이터 연결 여부를 보여 주는 데만 씁니다. 인터넷 권한은 없습니다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 앱 메뉴의 "제거"가 안드로이드 제거 확인 창을 띄우는 데 필요합니다. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 빠른 설정의 밝기 막대가 화면 밝기를 바꾸는 데 씁니다. 사용자가 "시스템 설정 변경"을 허용해야만 동작합니다. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- 모니터 연결 지켜보기(알림) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 허용하면 모니터를 꽂았을 때 PC 화면을 바로 엶 (안드로이드는 화면 밖 앱이 화면을 여는 것을 막음) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 시작 메뉴에 보여 줄 앱(런처에 나오는 앱) 목록 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 바탕화면에 올릴 수 있는 위젯을 가진 앱 -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 폰 화면: 연결 도우미 + 터치패드 (앱 아이콘) -->
        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.daesinnam.pc.phone"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PC 화면(바탕화면 · 작업 표시줄 · 시작 메뉴 · 창): 모니터에서 열림.
             덜누름 PC 런처를 기본 홈 앱으로 고르면 데스크톱 모드 모니터에서는 안드로이드가 이 화면을 저절로 엽니다(SECONDARY_HOME). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 모니터 연결 지켜보기 (켜 두면 꽂자마자 PC 화면을 엶) -->
        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="외부 모니터가 연결되면 그 모니터에 데스크톱 화면을 엶" />
        </service>

        <!-- 터치패드 (접근성): 모니터 포인터 · 누르기 · 끌기 · 넘기기, 폰 키보드로 글자 넣기 -->
        <service
            android:name=".PointerService"
            android:exported="true"
            android:label="덜누름 PC 런처 터치패드"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pointer_service" />
        </service>
        <!-- DeX에서 화면 밀도가 바뀌어도 앱을 다시 시작하지 않게 (삼성) -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <!-- 고급 기능(Shizuku) 연결: 데스크톱 모드 켜기 · 창정리 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
